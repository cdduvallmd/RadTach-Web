rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/Config/admins).data[request.auth.uid] == true;
    }

    // Config (systems, admins, groupStats, compositeStats, workstationStats, systemSettings):
    // any logged-in user can read, only global admins can write.
    // {document=**} covers subcollections at any depth (e.g. config/groupStats/{system}/{date}).
    match /Config/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // User data: own data + admin read; write rules vary by subcollection
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Sessions: any authenticated user can create/update (offline buffer cross-user flush)
      // Read and delete remain restricted to owner + admin
      match /sessions/{sessionId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null;
        allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());

        // Events within sessions: same rules as sessions
        match /events/{eventId} {
          allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
          allow create, update: if request.auth != null;
          allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
        }
      }

      // Settings: owner + admin only (not relaxed for cross-user flush)
      match /settings/{settingId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Role requests: users create own, admin reads all + deletes after processing
    match /roleRequests/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // System settings: any logged-in user can read, only global admins can write.
    match /systems/{systemName} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Stale GAR markers: any authenticated user can create (offline buffer replay),
    // any authenticated user can read, global admins + per-system admins + per-system presidents can delete (after GAR recomputation)
    match /staleGAR/{markerId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && (
        isAdmin() ||
        get(/databases/$(database)/documents/systems/$(resource.data.system)).data.admins[request.auth.uid] == true ||
        get(/databases/$(database)/documents/systems/$(resource.data.system)).data.presidents[request.auth.uid] == true
      );
    }
  }
}
