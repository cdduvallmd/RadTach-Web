rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/Config/admins).data[request.auth.uid] == true;
    }

    // Config (systems, admins, groupStats, compositeStats, workstationStats, systemSettings):
    // any logged-in user can read, only global admins can write.
    // {document=**} covers subcollections at any depth (e.g. config/groupStats/{system}/{date}).
    match /Config/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // collectionGroup queries on sessions (used by president reports + GAR computation).
    // Only global admins and per-system admins/presidents need cross-user session reads.
    match /{path=**}/sessions/{sessionId} {
      allow read: if request.auth != null && isAdmin();
    }

    // User data: own data + admin read; write rules vary by subcollection
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Sessions: owner writes freely; cross-user flush (offline buffer replay) requires
      // _flushedBy == caller's UID so the audit trail is enforced server-side.
      match /sessions/{sessionId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && (
          request.auth.uid == userId ||
          request.resource.data._flushedBy == request.auth.uid
        );
        allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());

        // Events within sessions: same cross-user flush rule
        match /events/{eventId} {
          allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
          allow create, update: if request.auth != null && (
            request.auth.uid == userId ||
            request.resource.data._flushedBy == request.auth.uid
          );
          allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
        }
      }

      // Settings: owner + admin only (not relaxed for cross-user flush)
      match /settings/{settingId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // Sidecar command doc: owner only
      match /commands/{commandId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Session status (Sidecar gating): owner only
      match /status/{statusId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Role requests: users create own, admin reads all + deletes after processing
    match /roleRequests/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // System settings: any logged-in user can read, only global admins can write.
    match /systems/{systemName} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Stale GAR markers: write-once (create only, no update — prevents system field mutation),
    // any authenticated user can read, global admins + per-system admins + per-system presidents can delete (after GAR recomputation)
    match /staleGAR/{markerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && (
        isAdmin() ||
        get(/databases/$(database)/documents/systems/$(resource.data.system)).data.admins[request.auth.uid] == true ||
        get(/databases/$(database)/documents/systems/$(resource.data.system)).data.presidents[request.auth.uid] == true
      );
    }
  }
}
